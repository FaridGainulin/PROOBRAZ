.footer
  &__container
    display: flex
    flex-direction: column
    align-items: center
    gap: 10px
    +above($breakpoints.sm)
      flex-direction: row
      justify-content space-between

  &__title
    display: none
    +above($breakpoints.sm)
      display: block
      text-align: center

  &__logo
    width 120px
    height: auto
    +above($breakpoints.sm)
      width 130px
    +above($breakpoints.md)
      width 140px
    +above($breakpoints.xxl)
      width 152px

  &__privacy-mobile
    cursor pointer
    text-decoration: underline
    color: #ffffff60
    +above($breakpoints.sm)
      display: none

  &__call-me
    cursor pointer
    text-decoration: underline
    color: #ffffff60
